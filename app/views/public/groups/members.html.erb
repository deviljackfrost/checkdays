<h1>グループメンバー一覧</h1>
 
<table class =  "member_content">
  
  <thead>
   <tr>
    <th>名前</th>
    <th>メールアドレス</th>
   </tr>
  </thead>
  <tbody>
     <% @members.each do |member| %>
   <tr>
    <td><%= member.name %></td>
    <td><%= member.email %></td>
   </tr>
    <% end %>
  </tbody>
</table>    

