
  
  <tbody>
    <% @groups.each do |group| %>
    <group_content>
      <tr>
        <td>グループ名</td>
        <td><%= link_to group.name, group_path(group.id) %></td>
        <br>
        <td>詳細</td>
        <br>
        <td><%= group.introduction %></td>
        <br>
        <br>
        <% if group.owner_id == current_user.id %>
          <td><%= link_to '編集', edit_group_path(group.id), class: "btn btn-sm btn-success" %></td>
        <% end %>
      </tr>
      </group_content>
    <% end %>
  </tbody>
