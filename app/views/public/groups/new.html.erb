<div>
  <%= flash[:alert] %>
</div>
    <post>
      <h2>グループ作成</h2>
      <%= form_with model: @group, local: true do |f| %>
        <div class="form-group">
          <%= f.label :タイトル %>
          <br>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :内容 %>
          <br>
          <%= f.text_area :introduction, class: "form-control", rows: 5 %>
        </div>
        <%= f.submit "作成", class: "btn btn-primary" %>
      <% end %>
    </div>
</post>