<div>
  <%= flash[:alert] %>
</div>

<h1>ユーザー編集</h1>


<%= form_with model: @user, url: users_content_path(@user.id), method: :patch do |f| %>
<user_edit>
  <h4>画像</h4>
  <%= f.file_field :images, accept: "image/*" %>
  
  <h4>名前</h4>
  <%= f.text_field :name %>
  
    <h4>メールアドレス</h4>
  <%= f.text_field :email %>
  
  <%= f.submit '保存' %>
  <br>
  
  <h4>
  <%= link_to "パスワード変更", edit_user_registration_path(@user) %>
  </h4>
  
  
  <delete>
  <%= link_to "ユーザー退去", users_content_path, method: :delete, data: { confirm: "本当に退去しますか？" } %>
  </delete>
  
<% end %>
</user_edit>