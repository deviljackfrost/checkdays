<h2>パスワードをお忘れですか？</h2>

<%= form_with model: @user, url:user_registration_path(@user.id), class: 'registration-main', local: true do |f| %>
   <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="actions">
    <%= f.submit "パスワードリセット" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
