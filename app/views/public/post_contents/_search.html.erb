<%= search_form_for @q, url: url do |f| %>
   <%= f.search_field :title_or_caption_cont, class: 'form-control', placeholder: '検索ワード' %>
   <%= f.submit '検索', class: 'btn btn-primary' %>
<% end %>

<% @post_content.each do |post_content| %>
    <p>ユーザー：<%= post_content.user&.name || "このユーザーは退会されました" %></p>
    <p>タイトル：<%= post_content.title %></p>
    <p>本文：<%= post_content.caption %></p>
<% end %>