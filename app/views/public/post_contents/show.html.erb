
<div>
  <%= flash[:notice] %>
</div>


<content>
<%= form_with model: @post_content, url: post_content_path(@post_content.id), method: :patch do |f| %>

<br>
<h2><p><%= @post_content.user.name %></p></h2>
<br>
<h2><p><%= @post_content.title %></p></h2>
<br>
<image>
<% if @post_content.image.attached? %>
  <%= image_tag @post_content.image, size: "300x300" %>
<% else %>
<% end %>
</image>
<h2><p><%= @post_content.caption %></p></h2>
 
   <br>
   <h2>投稿日</h2>
   <p><%= @post_content.created_at.strftime('%Y-%m-%d %H:%M') %></p>
<% end %>
  <% if @post_content.user == current_user %> 
 <%= link_to "編集", edit_post_content_path(@post_content) %>
 <%= link_to "削除", post_content_path(@post_content), method: :delete, "data-confirm" => "本当に削除しますか？" %>
   <% end %>
</content>



<div class = "comment" >
  <p>コメント件数：<%= @post_content.post_comments.count %></p>
  <% @post_content.post_comments.page(params[:page]).per(5).order(created_at: :desc).each do |post_comment| %>
  <div1>
    ユーザー：<%= post_comment.user.name %>
    <div class = "comment_content" ><%= post_comment.comment %></div>
    <div class = "time" ><%= post_comment.created_at.strftime('%Y-%m-%d %H:%M') %></div>
    
  <% if post_comment.user == current_user %>
  
   <%= link_to "編集", edit_post_content_post_comment_path(@post_content,post_comment.id) %>
   <%= link_to "削除", post_content_post_comment_path(@post_content,post_comment), method: :delete %>
   <% else %>
    <% end %>
     </div1>
  <% end %>
  
  <%= paginate @post_comments %>
</div>
    <br>
<comment_up>
  <% if current_user.guest? %>
    <% else %>
  <%= form_with model: [@post_content, @post_comment] do |f| %>
    <%= f.text_area :comment, rows: '5', placeholder: "コメント" %>
    <%= f.submit "コメント送信" %>
  <% end %>
    <% end %>
</comment_up>

 <%= form_with model: @post_content, url: post_content_path(@post_content.id), method: :patch do |f| %>
 
<li>
    <%= link_to "一覧へ戻る", post_contents_path(@post_content.id) %>
</li>
<% end %>
