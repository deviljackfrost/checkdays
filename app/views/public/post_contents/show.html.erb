

<content>
    <%= form_with model: @post_content, url: post_content_path(@post_content.id), method: :patch do |f| %>
<h2>タイトル</h2>
<p><%= @post_content.title %></p>

<h2>本文</h2>
<p><%= @post_content.caption %></p>

<h2>ユーザーネーム</h2>
 <p><%= @post_content.user.name %></p>
    <%= link_to "編集", edit_post_content_path(@post_content) %>
   <%= link_to "削除", post_content_path(@post_content), method: :delete %>
<% end %>
</content>



<div class = "comment" >
  <p>コメント件数：<%= @post_content.post_comments.count %></p>
  <% @post_content.post_comments.each do |post_comment| %>
   <br>
    <%= post_comment.user.name %>
    <br>
    <%= post_comment.created_at.strftime('%Y/%m/%d') %>
      <br>
    <%= post_comment.comment %>
      <br>
  <% end %>
</div>
    <br>
<div>
  <%= form_with model: [@post_content, @post_comment] do |f| %>
    <%= f.text_area :comment, rows: '5', placeholder: "コメント" %>
    <%= f.submit "入力する" %>
  <% end %>
</div>

 <%= form_with model: @post_content, url: post_content_path(@post_content.id), method: :patch do |f| %>
<li>
    <%= link_to "一覧へ戻る", post_contents_path(@post_content.id) %>
</li>
<% end %>
