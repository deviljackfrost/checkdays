<h1>全投稿一覧</h1>
 
<% @post_content.each do |post_content| %>
   <content>
    <p>ユーザー：<%= post_content.user&.name || "このユーザーは退会されました" %></p>
    <p>タイトル：<%= post_content.title %></p>
    <p>本文：<%= post_content.caption %></p>
     <p><%= "#{post_content.post_comments.count} コメント"%></p>
     <%= link_to '削除', admin_post_content_path(post_content), method: :delete, data: { confirm: '本当に削除しますか？' } %> 
   </content>
<% end %>
