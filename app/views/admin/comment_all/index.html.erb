<h1>全コメント一覧</h1>
 
<% @post_comment.each do |post_comment| %>
   <content>
    <p>ユーザー：<%= post_comment.user&.name || "このユーザーは退会されました" %></p>
    <p>本文：<%= post_comment.comment %></p>
     <p><%= link_to "#{post_comment.post_comments.count} コメント", post_comment_path(post_comment.id) %></p>
     <%= link_to '削除', admin_post_comment_path(post_comment), method: :delete, data: { confirm: '本当に削除しますか？' } %> 
   </content>
<% end %>
