


<content>
  <h1>投稿一覧</h1>

<% if user_signed_in? %>
<%= search_form_for @q do |f| %>
  <%= f.label :title_or_caption_cont, 'title or caption' %>
  <%= f.search_field :title_or_caption_cont, class: "form-control" %>

  <%= f.submit "検索" %>

  <%= link_to '一覧を出す', post_contents_path %>
  <% end %>
<% end %>


<% @search.each do |post_content| %>
  <div1>
    <p>ユーザー：<%= post_content.user&.name || "このユーザーは退会されました" %></p>
    <p>タイトル：<%= post_content.title %></p>
    <p>本文：<%= post_content.caption %></p>
    
   <% if post_content.user == current_user %>
   
   <%= link_to "編集", post_content_path(post_content.id) %>
   <%= link_to "削除", post_content_path(post_content), method: :delete %>
    <% end %>
    
  </div1>
<% end %>
  </content>
